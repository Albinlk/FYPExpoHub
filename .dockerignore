# Exclude local build directories
build/
.dart_tool/
.packages
.pub-cache/
.pub/

# Exclude git references
.git/
.gitignore

# Exclude IDE specific directories
.idea/
.vscode/
*.imap
*.apk
*.ipa

# Exclude secrets — never bake into image layers
serviceAccountKey.json
service-account*.json
.env
.env.*
*.key
*.p12
*.keystore
*.jks

# Exclude Cloud Functions and local development packages
functions/node_modules/
node_modules/

# Exclude local system logs
*.log
