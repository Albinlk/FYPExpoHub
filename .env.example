# FYP Expo Hub — Environment Configuration
# Copy this file to .env and fill in the values.
# The .env file is gitignored and must never be committed.

# ─── Server ───────────────────────────────────────────────────────────────────
# Port exposed on the host machine (default: 8081)
PORT=8081

# ─── Firebase Credentials ─────────────────────────────────────────────────────
# These are injected as --dart-define flags at Docker build time.
# Obtain values from the Firebase Console → Project Settings → Your Apps → Web app.
FIREBASE_API_KEY=your-api-key-here
FIREBASE_APP_ID=your-app-id-here
FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
FIREBASE_PROJECT_ID=your-project-id-here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
