# FYP Expo Hub — Environment Configuration (Supabase Free Tier)
# Copy this file to .env and fill in the values.
# The .env file is gitignored and must never be committed.

# ─── Web Server ───────────────────────────────────────────────────────────────
# Port exposed on the host machine (default: 8081)
PORT=8081

# ─── Supabase Configuration ───────────────────────────────────────────────────
# Obtain values from your Supabase Dashboard: Project Settings → API
# Injected into Flutter Web via --dart-define at build time.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ─── Migration & Admin Tooling Only (Never in Flutter Web) ───────────────────
# Used strictly by local CLI tools for data migration/reconciliation.
# NEVER commit or expose the service role key to frontend bundles.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
